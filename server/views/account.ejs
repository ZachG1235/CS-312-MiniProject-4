<%- include('partials/header') %> 

<br>
<h1 class="text-center">Account information for "<%= current_user.name %>"</h1>
<h2 class="text-center">Modify fields by submitting new data</h2>
<div class="cust-max-screen-width-900">
<form action="/account" method="POST">
    <div class="form-floating mb-3">
        <input type="email" class="form-control" placeholder="name@email" id="new_user_id" name="new_user_id">
        <label for="new_user_id">New Email Address</label>
    </div>
    <div class="form-floating mb-3">
        <input type="password" class="form-control" placeholder="*****" id="new_password" name="new_password"> 
        <label for="new_password">New Password</label>
    </div>
    <div class="form-floating mb-3">
        <input type="text" class="form-control" placeholder="John Doe" id="new_display_name" name="new_display_name"> 
        <label for="new_display_name">New Display Name</label>
    </div>
    
    <br>
    <div class="d-flex justify-content-center">
        <button class="btn btn-success custom-button-padding" type="submit">Save</button>
    </div>
</form>
<form action="/return-home" method="POST">
    <div class="d-flex justify-content-center">
        <button class="btn btn-secondary custom-button-padding" type="submit">Cancel</button>
    </div>
</form>
</div>


<%- include('partials/footer') %>