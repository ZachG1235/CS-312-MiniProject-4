<%- include('partials/header') %> 
<br>
<h1 class="text-center">Now Editing Blog Post "<%= blog_data.title %>"</h1>
<div class="cust-max-screen-width-900">
<form action="/update/<%= blog_data.blog_id %>?_method=PUT" method="POST">
    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Blog Title" id="blogtitle" name="blogtitle" value="<%= blog_data.title%>" required> 
    </div>
    <div>
        <textarea class="form-control" placeholder="Write Blog content here..." id="blogcontent" name="blogcontent" aria-label="With textarea" required><%= blog_data.body%></textarea> 
    </div> 
    <br>
    <div class="d-flex justify-content-center">
        <button class="btn btn-success custom-button-padding" type="submit">Save</button>
    </div>
</form>
<form action="/return-home" method="POST">
    <div class="d-flex justify-content-center">
        <button class="btn btn-secondary custom-button-padding" type="submit">Cancel</button>
    </div>
</form>
</div>
<%- include('partials/footer') %>